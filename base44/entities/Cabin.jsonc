{
  "name": "Cabin",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre"
    },
    "type": {
      "type": "string",
      "enum": [
        "caba\u00f1a",
        "sal\u00f3n"
      ],
      "default": "caba\u00f1a",
      "title": "Tipo"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "capacity": {
      "type": "string",
      "title": "Capacidad"
    },
    "rooms": {
      "type": "string",
      "title": "Dormitorios / Ambientes"
    },
    "pool": {
      "type": "string",
      "title": "Piscina"
    },
    "high_season_price": {
      "type": "number",
      "title": "Precio temporada alta"
    },
    "low_season_price": {
      "type": "number",
      "title": "Precio temporada baja"
    },
    "sector": {
      "type": "string",
      "title": "Sector"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Fotos",
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "Activa"
    },
    "order": {
      "type": "number",
      "default": 0,
      "title": "Orden"
    }
  },
  "required": [
    "name",
    "type"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}