{
  "name": "Notificar reserva nueva",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "BookingRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_new_booking",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNewBooking",
            "args": {
              "booking_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notificar administradores",
            "description": "Env\u00eda email de nueva reserva a los admins"
          }
        }
      }
    ]
  },
  "description": "Env\u00eda un email a los administradores cuando llega una nueva solicitud de reserva desde el sitio web"
}